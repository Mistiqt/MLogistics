<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PLANER MATERIJALA ERP</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        erpdark: '#0b0f19',
                        erppanel: '#111827',
                        erpborder: '#1f2937',
                        erpsidebar: '#0f172a',
                    }
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #0b0f19; }
        ::-webkit-scrollbar-thumb { background: #1f2937; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #374151; }
    </style>
</head>
<body class="bg-erpdark text-gray-100 font-sans antialiased min-h-screen flex relative">

    <!-- SKRIVENI FILE INPUTI ZA CSV UVOZ -->
    <input type="file" id="csvMaterialsInput" accept=".csv" class="hidden" onchange="importMaterialsCSV(event)">
    <input type="file" id="csvPlansInput" accept=".csv" class="hidden" onchange="importPlansCSV(event)">

    <!-- SIDEBAR -->
    <aside class="w-64 bg-erpsidebar border-r border-erpborder flex flex-col justify-between shrink-0 select-none z-10">
        <div>
            <!-- Logo / Brand -->
            <div class="p-6 border-b border-erpborder flex items-center space-x-3">
                <div class="bg-blue-600 text-white p-2 rounded-lg flex items-center justify-center">
                    <i data-lucide="box" class="w-5 h-5"></i>
                </div>
                <div>
                    <h1 class="font-bold tracking-wide text-sm text-white">PLANER</h1>
                    <p class="text-[10px] text-gray-400 tracking-wider">MATERIJALA ERP</p>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="p-4 space-y-1.5">
                <button onclick="switchTab('dashboard')" id="nav-dashboard" class="w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-colors bg-blue-600/20 text-blue-400 border border-blue-500/30">
                    <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                    <span>Kontrolna Tabla</span>
                </button>
                <button onclick="switchTab('materials')" id="nav-materials" class="w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-colors text-gray-400 hover:bg-gray-800 hover:text-gray-200">
                    <i data-lucide="package" class="w-4 h-4"></i>
                    <span>Materijali</span>
                </button>
                <button onclick="switchTab('suppliers')" id="nav-suppliers" class="w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-colors text-gray-400 hover:bg-gray-800 hover:text-gray-200">
                    <i data-lucide="truck" class="w-4 h-4"></i>
                    <span>Dobavljači</span>
                </button>
                <button onclick="switchTab('plans')" id="nav-plans" class="w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-colors text-gray-400 hover:bg-gray-800 hover:text-gray-200">
                    <i data-lucide="file-text" class="w-4 h-4"></i>
                    <span>Proizvodni Planovi</span>
                </button>
                <button onclick="switchTab('matrix')" id="nav-matrix" class="w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-colors text-gray-400 hover:bg-gray-800 hover:text-gray-200">
                    <i data-lucide="trending-up" class="w-4 h-4"></i>
                    <span>Matrica Pokrivenosti</span>
                </button>
                <button onclick="switchTab('csv')" id="nav-csv" class="w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-colors text-gray-400 hover:bg-gray-800 hover:text-gray-200">
                    <i data-lucide="file-spreadsheet" class="w-4 h-4"></i>
                    <span>CSV Uvoz / Izvoz</span>
                </button>
            </nav>
        </div>

        <!-- User Profile Footer -->
        <div class="p-4 border-t border-erpborder">
            <p class="text-[10px] text-gray-500 uppercase tracking-wider mb-1">Prijavljen</p>
            <p class="text-xs font-semibold text-gray-200 truncate">Dušan Kostić</p>
            <p class="text-[11px] text-gray-400 truncate mb-3">dusan.kostic@zf.com</p>
            <button class="w-full flex items-center justify-center space-x-2 text-xs text-red-400 bg-red-500/10 hover:bg-red-500/20 py-2 rounded-lg transition-colors border border-red-500/20">
                <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
                <span>Odjava</span>
            </button>
        </div>
    </aside>

    <!-- MAIN CONTENT AREA -->
    <main class="flex-1 overflow-y-auto p-10">

        <!-- 1. KONTROLNA TABLA -->
        <section id="tab-dashboard" class="space-y-6 tab-content">
            <div>
                <h2 class="text-2xl font-bold tracking-tight text-white uppercase">Kontrolna Tabla</h2>
                <p class="text-sm text-gray-400">Realno stanje pokrivenosti materijala u odnosu na proizvodne planove (uključujući tranzit)</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div class="bg-erppanel border border-erpborder rounded-xl p-5 relative overflow-hidden flex flex-col justify-between">
                    <div class="flex justify-between items-start">
                        <span class="text-xs font-semibold tracking-wider text-gray-400 uppercase">Ukupno Materijala</span>
                        <i data-lucide="box" class="w-5 h-5 text-gray-500"></i>
                    </div>
                    <div id="statTotalMaterials" class="text-4xl font-extrabold text-white mt-4">0</div>
                    <div class="absolute bottom-0 left-0 right-0 h-1 bg-blue-500"></div>
                </div>

                <div class="bg-erppanel border border-erpborder rounded-xl p-5 relative overflow-hidden flex flex-col justify-between">
                    <div class="flex justify-between items-start">
                        <span class="text-xs font-semibold tracking-wider text-red-400 uppercase">Kritično (&lt;3 dana)</span>
                        <i data-lucide="alert-triangle" class="w-5 h-5 text-red-400"></i>
                    </div>
                    <div id="statCritical" class="text-4xl font-extrabold text-white mt-4">0</div>
                    <div class="absolute bottom-0 left-0 right-0 h-1 bg-red-500"></div>
                </div>

                <div class="bg-erppanel border border-erpborder rounded-xl p-5 relative overflow-hidden flex flex-col justify-between">
                    <div class="flex justify-between items-start">
                        <span class="text-xs font-semibold tracking-wider text-amber-400 uppercase">Upozorenje (3–7 dana)</span>
                        <i data-lucide="trending-down" class="w-5 h-5 text-amber-400"></i>
                    </div>
                    <div id="statWarning" class="text-4xl font-extrabold text-white mt-4">0</div>
                    <div class="absolute bottom-0 left-0 right-0 h-1 bg-amber-500"></div>
                </div>

                <div class="bg-erppanel border border-erpborder rounded-xl p-5 relative overflow-hidden flex flex-col justify-between">
                    <div class="flex justify-between items-start">
                        <span class="text-xs font-semibold tracking-wider text-emerald-400 uppercase">Optimalno (&gt;7 dana)</span>
                        <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-400"></i>
                    </div>
                    <div id="statOptimal" class="text-4xl font-extrabold text-white mt-4">0</div>
                    <div class="absolute bottom-0 left-0 right-0 h-1 bg-emerald-500"></div>
                </div>
            </div>

            <div class="bg-erppanel border border-erpborder rounded-xl overflow-hidden shadow-xl">
                <div class="p-5 border-b border-erpborder flex justify-between items-center">
                    <div>
                        <p class="text-xs text-gray-400 uppercase tracking-wider">Alert Lista</p>
                        <h3 class="text-base font-bold text-white">Kritični materijali</h3>
                    </div>
                    <button onclick="switchTab('matrix')" class="text-xs text-blue-400 hover:text-blue-300 font-semibold tracking-wide flex items-center space-x-1">
                        <span>PUNA MATRICA</span>
                        <span>&rarr;</span>
                    </button>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-gray-900/50 text-[11px] text-gray-400 uppercase tracking-wider border-b border-erpborder">
                            <tr>
                                <th class="py-3 px-5">Part Broj</th>
                                <th class="py-3 px-5">Opis</th>
                                <th class="py-3 px-5">Dobavljač</th>
                                <th class="py-3 px-5">Stanje</th>
                                <th class="py-3 px-5">U tranzitu</th>
                                <th class="py-3 px-5">Dani Pokrića</th>
                                <th class="py-3 px-5">Prvi Manjak</th>
                                <th class="py-3 px-5">Status</th>
                            </tr>
                        </thead>
                        <tbody id="dashboardAlertsTable" class="divide-y divide-erpborder text-gray-300">
                            <!-- Dinamički popunjeno -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- 2. MATERIJALI -->
        <section id="tab-materials" class="space-y-6 tab-content hidden">
            <div class="flex justify-between items-center">
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-white uppercase">Materijali</h2>
                    <p class="text-sm text-gray-400">Registar svih šifri, opisa, stanja i količina u tranzitu</p>
                </div>
                <button onclick="openModal('materialModal')" class="bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-lg text-sm font-semibold flex items-center space-x-2 transition-colors">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    <span>Novi materijal</span>
                </button>
            </div>

            <div class="relative max-w-md">
                <i data-lucide="search" class="w-4 h-4 text-gray-500 absolute left-3.5 top-3"></i>
                <input type="text" id="materialSearchInput" oninput="renderMaterials()" placeholder="Pretraga po Part Broju ili opisu..." class="w-full bg-erppanel border border-erpborder rounded-lg pl-10 pr-4 py-2 text-sm text-gray-200 placeholder-gray-500 focus:outline-none focus:border-blue-500">
            </div>

            <div class="bg-erppanel border border-erpborder rounded-xl overflow-hidden shadow-xl">
                <table class="w-full text-left text-sm">
                    <thead class="bg-gray-900/50 text-[11px] text-gray-400 uppercase tracking-wider border-b border-erpborder">
                        <tr>
                            <th class="py-3 px-5">Part Broj</th>
                            <th class="py-3 px-5">Opis</th>
                            <th class="py-3 px-5">Dobavljač</th>
                            <th class="py-3 px-5">Stanje</th>
                            <th class="py-3 px-5">U tranzitu</th>
                            <th class="py-3 px-5">Min</th>
                            <th class="py-3 px-5 text-right">Akcije</th>
                        </tr>
                    </thead>
                    <tbody id="materialsTableBody" class="divide-y divide-erpborder text-gray-300">
                        <!-- Dinamički popunjeno -->
                    </tbody>
                </table>
            </div>
        </section>

        <!-- 3. DOBAVLJAČI -->
        <section id="tab-suppliers" class="space-y-6 tab-content hidden">
            <div class="flex justify-between items-center">
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-white uppercase">Dobavljači</h2>
                    <p class="text-sm text-gray-400">Kontakt informacije i vreme isporuke</p>
                </div>
                <button onclick="openModal('supplierModal')" class="bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-lg text-sm font-semibold flex items-center space-x-2 transition-colors">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    <span>Novi dobavljač</span>
                </button>
            </div>

            <div class="bg-erppanel border border-erpborder rounded-xl overflow-hidden shadow-xl">
                <table class="w-full text-left text-sm">
                    <thead class="bg-gray-900/50 text-[11px] text-gray-400 uppercase tracking-wider border-b border-erpborder">
                        <tr>
                            <th class="py-3 px-5">Naziv</th>
                            <th class="py-3 px-5">Kontakt</th>
                            <th class="py-3 px-5">Lead Time</th>
                            <th class="py-3 px-5">Napomena</th>
                            <th class="py-3 px-5 text-right">Akcije</th>
                        </tr>
                    </thead>
                    <tbody id="suppliersTableBody" class="divide-y divide-erpborder text-gray-300">
                        <!-- Dinamički popunjeno -->
                    </tbody>
                </table>
            </div>
        </section>

        <!-- 4. PROIZVODNI PLANOVI -->
        <section id="tab-plans" class="space-y-6 tab-content hidden">
            <div class="flex justify-between items-center">
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-white uppercase">Proizvodni Planovi</h2>
                    <p class="text-sm text-gray-400">Datumi proizvodnje, količine i BOM (materijali po jedinici)</p>
                </div>
                <button onclick="openModal('planModal')" class="bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-lg text-sm font-semibold flex items-center space-x-2 transition-colors">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    <span>Novi plan</span>
                </button>
            </div>

            <div class="bg-erppanel border border-erpborder rounded-xl overflow-hidden shadow-xl">
                <table class="w-full text-left text-sm">
                    <thead class="bg-gray-900/50 text-[11px] text-gray-400 uppercase tracking-wider border-b border-erpborder">
                        <tr>
                            <th class="py-3 px-5">Datum</th>
                            <th class="py-3 px-5">Proizvod</th>
                            <th class="py-3 px-5">Količina</th>
                            <th class="py-3 px-5">BOM (Materijali)</th>
                            <th class="py-3 px-5 text-right">Akcije</th>
                        </tr>
                    </thead>
                    <tbody id="plansTableBody" class="divide-y divide-erpborder text-gray-300">
                        <!-- Dinamički popunjeno -->
                    </tbody>
                </table>
            </div>
        </section>

        <!-- 5. MATRICA POKRIVENOSTI -->
        <section id="tab-matrix" class="space-y-6 tab-content hidden">
            <div class="flex justify-between items-center">
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-white uppercase">Matrica Pokrivenosti</h2>
                    <p class="text-sm text-gray-400">Preostali dani pokrića i dnevna projekcija za svaki materijal</p>
                </div>
                <div class="relative">
                    <select id="matrixDaysSelect" onchange="renderMatrix()" class="bg-erppanel border border-erpborder rounded-lg px-3 py-2 text-xs text-gray-200 focus:outline-none focus:border-blue-500 cursor-pointer">
                        <option value="7">7 dana</option>
                        <option value="14">14 dana</option>
                        <option value="30" selected>30 dana</option>
                        <option value="60">60 dana</option>
                        <option value="90">90 dana</option>
                    </select>
                </div>
            </div>

            <div class="bg-erppanel border border-erpborder rounded-xl overflow-hidden shadow-xl">
                <table class="w-full text-left text-sm">
                    <thead class="bg-gray-900/50 text-[11px] text-gray-400 uppercase tracking-wider border-b border-erpborder">
                        <tr>
                            <th class="py-3 px-5">Part Broj</th>
                            <th class="py-3 px-5">Opis</th>
                            <th class="py-3 px-5">Dobavljač</th>
                            <th class="py-3 px-5">Stanje</th>
                            <th class="py-3 px-5">U tranzitu</th>
                            <th class="py-3 px-5">Min</th>
                            <th class="py-3 px-5">Dani Pokrića</th>
                            <th class="py-3 px-5">Prvi Manjak</th>
                            <th class="py-3 px-5">Status</th>
                            <th class="py-3 px-5 text-right">Projekcija</th>
                        </tr>
                    </thead>
                    <tbody id="matrixTableBody" class="divide-y divide-erpborder text-gray-300">
                        <!-- Dinamički popunjeno -->
                    </tbody>
                </table>
            </div>
        </section>

        <!-- 6. CSV UVOZ / IZVOZ -->
        <section id="tab-csv" class="space-y-6 tab-content hidden">
            <div>
                <h2 class="text-2xl font-bold tracking-tight text-white uppercase">CSV Uvoz / Izvoz</h2>
                <p class="text-sm text-gray-400">Masovni unos materijala i proizvodnih planova</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-erppanel border border-erpborder rounded-xl p-6 flex flex-col justify-between shadow-xl">
                    <div>
                        <div class="flex items-center space-x-2 mb-2 text-white font-semibold">
                            <i data-lucide="file-spreadsheet" class="w-5 h-5 text-blue-400"></i>
                            <h3>Uvoz materijala</h3>
                        </div>
                        <p class="text-xs text-gray-400 mb-4">CSV format bez kolone za jedinicu mere.</p>
                        
                        <div class="bg-gray-950 border border-erpborder rounded-lg p-3 font-mono text-xs text-gray-400 mb-5 overflow-x-auto space-y-1">
                            <p class="text-gray-300">part_number;description;supplier_name;current_stock;in_transit;min_stock</p>
                            <p>M-001;Zavrtanj M8;TestSup;1200;100;300</p>
                        </div>
                    </div>
                    <button onclick="document.getElementById('csvMaterialsInput').click()" class="bg-blue-600 hover:bg-blue-500 text-white px-4 py-2.5 rounded-lg text-sm font-semibold flex items-center justify-center space-x-2 transition-colors">
                        <i data-lucide="upload" class="w-4 h-4"></i>
                        <span>Uvezi CSV</span>
                    </button>
                </div>

                <div class="bg-erppanel border border-erpborder rounded-xl p-6 flex flex-col justify-between shadow-xl">
                    <div>
                        <div class="flex items-center space-x-2 mb-2 text-white font-semibold">
                            <i data-lucide="file-spreadsheet" class="w-5 h-5 text-blue-400"></i>
                            <h3>Uvoz proizvodnih planova</h3>
                        </div>
                        <p class="text-xs text-gray-400 mb-4">Svaki red = jedan BOM element sa pripadajućom količinom po jedinici.</p>
                        
                        <div class="bg-gray-950 border border-erpborder rounded-lg p-3 font-mono text-xs text-gray-400 mb-5 overflow-x-auto space-y-1">
                            <p class="text-gray-300">product_name;plan_date;quantity;part_number;qty_per_unit</p>
                            <p>Sklop-A;2026-09-15;100;222333;2</p>
                        </div>
                    </div>
                    <button onclick="document.getElementById('csvPlansInput').click()" class="bg-blue-600 hover:bg-blue-500 text-white px-4 py-2.5 rounded-lg text-sm font-semibold flex items-center justify-center space-x-2 transition-colors">
                        <i data-lucide="upload" class="w-4 h-4"></i>
                        <span>Uvezi CSV</span>
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
                <div class="bg-erppanel border border-erpborder rounded-xl p-6 flex items-center justify-between shadow-xl">
                    <div>
                        <p class="text-xs text-gray-400 uppercase tracking-wider font-semibold">IZVOZ</p>
                        <h3 class="text-base font-bold text-white">Registar materijala</h3>
                        <p class="text-xs text-gray-400 mt-0.5">Sve šifre, stanja, tranzit i dobavljači</p>
                    </div>
                    <button onclick="exportMaterialsCSV()" class="bg-cyan-600 hover:bg-cyan-500 text-white px-4 py-2 rounded-lg text-sm font-semibold flex items-center space-x-2 transition-colors">
                        <i data-lucide="download" class="w-4 h-4"></i>
                        <span>Preuzmi</span>
                    </button>
                </div>

                <div class="bg-erppanel border border-erpborder rounded-xl p-6 flex items-center justify-between shadow-xl">
                    <div>
                        <p class="text-xs text-gray-400 uppercase tracking-wider font-semibold">IZVOZ</p>
                        <h3 class="text-base font-bold text-white">Izveštaj pokrivenosti</h3>
                        <p class="text-xs text-gray-400 mt-0.5">Dani pokrića, statusi, datumi manjka</p>
                    </div>
                    <button onclick="exportMatrixCSV()" class="bg-cyan-600 hover:bg-cyan-500 text-white px-4 py-2 rounded-lg text-sm font-semibold flex items-center space-x-2 transition-colors">
                        <i data-lucide="download" class="w-4 h-4"></i>
                        <span>Preuzmi</span>
                    </button>
                </div>
            </div>
        </section>

    </main>

    <!-- MODALNI PROZORI -->

    <!-- 1. MODAL: Novi materijal -->
    <div id="materialModal" class="fixed inset-0 bg-black/70 flex items-center justify-center z-50 hidden">
        <div class="bg-erppanel border border-erpborder rounded-xl w-full max-w-lg p-6 relative shadow-2xl space-y-5">
            <div class="flex justify-between items-center border-b border-erpborder pb-3">
                <h3 class="font-bold text-lg text-white">Novi materijal</h3>
                <button onclick="closeModal('materialModal')" class="text-gray-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
            </div>
            <form onsubmit="handleSaveMaterial(event)" class="space-y-4 text-sm">
                <div>
                    <label class="block text-gray-300 text-xs font-semibold mb-1">Part broj *</label>
                    <input type="text" id="newMatPart" required class="w-full bg-erpdark border border-blue-500/60 rounded-lg px-3.5 py-2 text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-gray-300 text-xs font-semibold mb-1">Opis</label>
                    <input type="text" id="newMatDesc" class="w-full bg-erpdark border border-erpborder rounded-lg px-3.5 py-2 text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-gray-300 text-xs font-semibold mb-1">Dobavljač</label>
                    <select id="newMatSupplier" class="w-full bg-erpdark border border-erpborder rounded-lg px-3.5 py-2 text-white focus:outline-none focus:border-blue-500">
                        <option value="">Bez dobavljača</option>
                    </select>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-gray-300 text-xs font-semibold mb-1">Stanje</label>
                        <input type="number" id="newMatStock" value="0" class="w-full bg-erpdark border border-erpborder rounded-lg px-3.5 py-2 text-white focus:outline-none focus:border-blue-500">
                    </div>
                    <div>
                        <label class="block text-gray-300 text-xs font-semibold mb-1">U tranzitu</label>
                        <input type="number" id="newMatTransit" value="0" class="w-full bg-erpdark border border-erpborder rounded-lg px-3.5 py-2 text-white focus:outline-none focus:border-blue-500">
                    </div>
                </div>
                <div>
                    <label class="block text-gray-300 text-xs font-semibold mb-1">Minimalna zaliha</label>
