    <!-- JavaScript Logika sa LocalStorage i CSV uvozom -->
    <script>
        const defaultMaterials = [
            { partNumber: '222333', description: 'Test', supplier: 'TestSup', stock: 1200, transit: 100, minStock: 50 },
            { partNumber: 'IMP-001', description: 'Imported Part 1', supplier: 'TestSup', stock: 500, transit: 0, minStock: 20 },
            { partNumber: 'IMP-002', description: 'Imported Part 2', supplier: 'TestSup', stock: 250, transit: 50, minStock: 15 },
            { partNumber: 'T-1789168316', description: 'TestMat', supplier: 'TestSup', stock: 100, transit: 0, minStock: 10 }
        ];

        const defaultSuppliers = [
            { name: 'TestSup', contact: 'a@b.com', leadTime: 5, note: '' }
        ];

        const defaultPlans = [
            { id: 1, date: '2026-09-15', product: 'UIProdA', quantity: 5, bom: [{ partNumber: '222333', qty: 2 }] },
            { id: 2, date: '2026-09-16', product: 'branik', quantity: 90, bom: [{ partNumber: '222333', qty: 1 }] },
            { id: 3, date: '2026-09-16', product: 'Instrument tabla', quantity: 200, bom: [{ partNumber: 'T-1789168316', qty: 1 }, { partNumber: 'IMP-002', qty: 1 }] }
        ];

        let materials = JSON.parse(localStorage.getItem('erp_materials')) || defaultMaterials;
        let suppliers = JSON.parse(localStorage.getItem('erp_suppliers')) || defaultSuppliers;
        let plans = JSON.parse(localStorage.getItem('erp_plans')) || defaultPlans;

        function saveData() {
            localStorage.setItem('erp_materials', JSON.stringify(materials));
            localStorage.setItem('erp_suppliers', JSON.stringify(suppliers));
            localStorage.setItem('erp_plans', JSON.stringify(plans));
            initApp();
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById('tab-' + tabId).classList.remove('hidden');

            document.querySelectorAll('aside nav button').forEach(btn => {
                btn.className = "w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-colors text-gray-400 hover:bg-gray-800 hover:text-gray-200";
            });
            document.getElementById('nav-' + tabId).className = "w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-lg text-sm font-medium transition-colors bg-blue-600/20 text-blue-400 border border-blue-500/30";
        }

        function openModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
            if(modalId === 'materialModal' || modalId === 'editMaterialModal') populateSupplierDropdowns();
            if(modalId === 'planModal') renderBomRowsInit('bomList');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }

        function populateSupplierDropdowns() {
            const selects = ['newMatSupplier', 'editSupplier'];
            selects.forEach(id => {
                const sel = document.getElementById(id);
                if(!sel) return;
                const currentVal = sel.value;
                sel.innerHTML = '<option value="">Bez dobavljača</option>';
                suppliers.forEach(s => {
                    const opt = document.createElement('option');
                    opt.value = s.name;
                    opt.textContent = s.name;
                    sel.appendChild(opt);
                });
                sel.value = currentVal;
            });
        }

        function calculateMaterialProjection(m, daysCount = 30) {
            let sup = suppliers.find(s => s.name === m.supplier);
            let leadTime = sup ? Number(sup.leadTime) : 0;

            let currentStock = Number(m.stock);
            let transitQty = Number(m.transit);
            let today = new Date();

            let projectionDays = [];
            let firstDeficitDate = null;
            let daysCoverCount = 0;
            let hasConsumptionPlan = false;

            for(let i = 0; i < daysCount; i++) {
                let d = new Date(today);
                d.setDate(today.getDate() + i);
                let dateStr = d.toISOString().split('T')[0];

                let consumption = 0;
                plans.forEach(p => {
                    if(p.date === dateStr) {
                        p.bom.forEach(b => {
                            if(b.partNumber === m.partNumber) {
                                consumption += (b.qty * p.quantity);
                            }
                        });
                    }
                });

                if (consumption > 0) hasConsumptionPlan = true;

                let transitArrival = 0;
                if(i === leadTime && transitQty > 0) {
                    transitArrival = transitQty;
                }

                let startStock = currentStock;
                let endStock = startStock - consumption + transitArrival;
                currentStock = endStock;

                projectionDays.push({
                    dateStr,
                    startStock,
                    consumption,
                    transitArrival,
                    endStock
                });

                if (endStock >= 0) {
                    daysCoverCount++;
                } else if (!firstDeficitDate) {
                    firstDeficitDate = dateStr;
                }
            }

            let status = 'NEMA PLANA';
            let statusClass = 'bg-gray-500/10 border-gray-500/30 text-gray-400';
            
            if (hasConsumptionPlan) {
                if (daysCoverCount < 3) {
                    status = 'KRITIČNO';
                    statusClass = 'bg-red-500/10 border-red-500/30 text-red-400';
                } else if (daysCoverCount <= 7) {
                    status = 'UPOZORENJE';
                    statusClass = 'bg-amber-500/10 border-amber-500/30 text-amber-400';
                } else {
                    status = 'OPTIMALNO';
                    statusClass = 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400';
                }
            }

            return {
                daysCoverCount: hasConsumptionPlan ? daysCoverCount : null,
                firstDeficitDate: firstDeficitDate || '—',
                status,
                statusClass,
                projectionDays
            };
        }

        function calculateAnalytics() {
            return materials.map(m => {
                let proj = calculateMaterialProjection(m, 30);
                return { 
                    ...m, 
                    dCover: proj.daysCoverCount !== null ? proj.daysCoverCount : null,
                    firstDeficit: proj.firstDeficitDate,
                    status: proj.status, 
                    statusClass: proj.statusClass 
                };
            });
        }

        function initApp() {
            renderMaterials();
            renderSuppliers();
            renderPlans();
            renderMatrix();
            renderDashboard();
            lucide.createIcons();
        }

        function renderDashboard() {
            let analytics = calculateAnalytics();
            let total = materials.length;
            let critical = analytics.filter(a => a.status === 'KRITIČNO').length;
            let warning = analytics.filter(a => a.status === 'UPOZORENJE').length;
            let optimal = analytics.filter(a => a.status === 'OPTIMALNO').length;

            document.getElementById('statTotalMaterials').textContent = total;
            document.getElementById('statCritical').textContent = critical;
            document.getElementById('statWarning').textContent = warning;
            document.getElementById('statOptimal').textContent = optimal;

            let tbody = document.getElementById('dashboardAlertsTable');
            tbody.innerHTML = '';
            analytics.filter(a => a.status === 'KRITIČNO').forEach(a => {
                tbody.innerHTML += `
                    <tr class="hover:bg-gray-800/40">
                        <td class="py-3.5 px-5 font-mono text-xs text-blue-400 underline cursor-pointer" onclick="openProjectionModal('${a.partNumber} • ${a.description}')">${a.partNumber}</td>
