                name: name,
                contact: document.getElementById('newSupContact').value,
                leadTime: Number(document.getElementById('newSupLead').value),
                note: document.getElementById('newSupNote').value
            });
            saveData();
            closeModal('supplierModal');
            e.target.reset();
        }

        function openEditSupplierModal(supName) {
            let s = suppliers.find(x => x.name === supName);
            if(!s) return;
            document.getElementById('editOriginalSupName').value = s.name;
            document.getElementById('editSupName').value = s.name;
            document.getElementById('editSupContact').value = s.contact;
            document.getElementById('editSupLead').value = s.leadTime;
