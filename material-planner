                    </tr>
                `;
            });
            lucide.createIcons();
        }

        function handleSaveMaterial(e) {
            e.preventDefault();
            let part = document.getElementById('newMatPart').value;
            if(materials.some(m => m.partNumber === part)) {
                alert('Materijal sa ovim part brojem već postoji!');
                return;
            }
            materials.push({
                partNumber: part,
                description: document.getElementById('newMatDesc').value,
                supplier: document.getElementById('newMatSupplier').value,
                stock: Number(document.getElementById('newMatStock').value),
                transit: Number(document.getElementById('newMatTransit').value),
                minStock: Number(document.getElementById('newMatMin').value)
            });
            saveData();
            closeModal('materialModal');
            e.target.reset();
        }

        function openEditMaterialModal(partNum) {
            let m = materials.find(x => x.partNumber === partNum);
            if(!m) return;
            populateSupplierDropdowns();
            document.getElementById('editOriginalPart').value = m.partNumber;
            document.getElementById('editPartNumber').value = m.partNumber;
            document.getElementById('editDescription').value = m.description;
            document.getElementById('editSupplier').value = m.supplier;
            document.getElementById('editStock').value = m.stock;
            document.getElementById('editTransit').value = m.transit;
            document.getElementById('editMinStock').value = m.minStock;
            openModal('editMaterialModal');
        }

        function handleUpdateMaterial(e) {
            e.preventDefault();
            let orig = document.getElementById('editOriginalPart').value;
            let idx = materials.findIndex(x => x.partNumber === orig);
            if(idx !== -1) {
                materials[idx] = {
                    partNumber: document.getElementById('editPartNumber').value,
                    description: document.getElementById('editDescription').value,
                    supplier: document.getElementById('editSupplier').value,
                    stock: Number(document.getElementById('editStock').value),
                    transit: Number(document.getElementById('editTransit').value),
                    minStock: Number(document.getElementById('editMinStock').value)
                };
                saveData();
                closeModal('editMaterialModal');
            }
        }

        function deleteMaterial(partNum) {
            if(confirm('Da li ste sigurni da želite da obrišete materijal?')) {
                materials = materials.filter(m => m.partNumber !== partNum);
                saveData();
            }
        }

