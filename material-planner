                    bomRows.push({ partNumber: part, qty: qty });
                });

                plans[idx] = {
                    id: planId,
                    product: document.getElementById('editPlanProduct').value,
                    date: document.getElementById('editPlanDate').value,
                    quantity: Number(document.getElementById('editPlanQty').value),
                    bom: bomRows
