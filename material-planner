            row.className = "flex items-center space-x-2 bg-erpdark p-2 rounded-lg border border-erpborder bom-row";
            
            let optionsHtml = materials.map(m => `<option value="${m.partNumber}" ${m.partNumber === selectedPart ? 'selected' : ''}>${m.partNumber} • ${m.description}</option>`).join('');

            row.innerHTML = `
                <select class="flex-1 bg-gray-900 border border-erpborder rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none bom-part">
                    ${optionsHtml}
                </select>
                <input type="number" value="${qtyVal}" min="1" class="w-20 bg-gray-900 border border-erpborder rounded-lg px-3 py-1.5 text-xs text-white text-center focus:outline-none bom-qty">
