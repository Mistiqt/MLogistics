        function openProjectionModal(titleText) {
            document.getElementById('projectionTitle').innerText = titleText;
            let partNum = titleText.split(' • ')[0];
            let m = materials.find(x => x.partNumber === partNum);
            if(!m) return;

            document.getElementById('projCardStock').innerText = m.stock;
            document.getElementById('projCardTransit').innerText = m.transit;

            let proj = calculateMaterialProjection(m, 30);
            document.getElementById('projCardDays').innerText = proj.daysCoverCount !== null ? proj.daysCoverCount + ' dana' : '—';

            let tbody = document.getElementById('projectionTableBody');
            tbody.innerHTML = '';

            proj.projectionDays.forEach(day => {
                tbody.innerHTML += `
                    <tr class="hover:bg-gray-800/40">
                        <td class="py-2.5 px-4 font-mono">${day.dateStr}</td>
                        <td class="py-2.5 px-4 text-right">${day.startStock}</td>
                        <td class="py-2.5 px-4 text-right text-amber-400">${day.consumption > 0 ? '-' + day.consumption : '0'}</td>
                        <td class="py-2.5 px-4 text-right text-blue-400">${day.transitArrival > 0 ? '+' + day.transitArrival : '—'}</td>
                        <td class="py-2.5 px-4 text-right font-semibold ${day.endStock < 0 ? 'text-red-400 font-bold' : 'text-white'}">${day.endStock}</td>
                    </tr>
                `;
            });

            openModal('projectionModal');
        }

        // --- CSV UVOZ FUNKCIJE ---
        function importMaterialsCSV(event) {
            let file = event.target.files[0];
            if (!file) return;

            let reader = new FileReader();
            reader.onload = function(e) {
                let text = e.target.result;
                let lines = text.split(/\r\n|\n/);
                let importedCount = 0;

                for (let i = 1; i < lines.length; i++) {
                    let line = lines[i].trim();
                    if (!line) continue;

                    let cols = line.split(';');
                    if (cols.length >= 6) {
                        let partNumber = cols[0].trim();
                        let description = cols[1].trim();
                        let supplier_name = cols[2].trim();
                        let current_stock = Number(cols[3].trim()) || 0;
                        let in_transit = Number(cols[4].trim()) || 0;
                        let min_stock = Number(cols[5].trim()) || 0;

                        if (supplier_name && !suppliers.some(s => s.name === supplier_name)) {
                            suppliers.push({ name: supplier_name, contact: '', leadTime: 3, note: 'Automatski dodat iz CSV-a' });
                        }

                        let existingIndex = materials.findIndex(m => m.partNumber === partNumber);
                        if (existingIndex !== -1) {
                            materials[existingIndex] = { partNumber, description, supplier: supplier_name, stock: current_stock, transit: in_transit, minStock: min_stock };
                        } else {
                            materials.push({ partNumber, description, supplier: supplier_name, stock: current_stock, transit: in_transit, minStock: min_stock });
                        }
                        importedCount++;
                    }
                }

                saveData();
                alert(`Uspešno uvezeno ${importedCount} materijala!`);
                event.target.value = '';
            };
            reader.readAsText(file, 'UTF-8');
        }

        function importPlansCSV(event) {
            let file = event.target.files[0];
            if (!file) return;

            let reader = new FileReader();
            reader.onload = function(e) {
                let text = e.target.result;
                let lines = text.split(/\r\n|\n/);
                let rawRows = [];

                for (let i = 1; i < lines.length; i++) {
                    let line = lines[i].trim();
                    if (!line) continue;

                    let cols = line.split(';');
                    if (cols.length >= 5) {
                        rawRows.push({
                            product_name: cols[0].trim(),
                            plan_date: cols[1].trim(),
                            quantity: Number(cols[2].trim()) || 1,
                            part_number: cols[3].trim(),
                            qty_per_unit: Number(cols[4].trim()) || 1
                        });
                    }
                }

                let groupedMap = {};
                rawRows.forEach(row => {
                    let key = `${row.product_name}_${row.plan_date}`;
                    if (!groupedMap[key]) {
                        groupedMap[key] = {
                            id: Date.now() + Math.random(),
                            product: row.product_name,
                            date: row.plan_date,
                            quantity: row.quantity,
                            bom: []
                        };
                    }
                    groupedMap[key].bom.push({
                        partNumber: row.part_number,
                        qty: row.qty_per_unit
                    });
                });

                let addedPlansCount = 0;
                Object.values(groupedMap).forEach(plan => {
                    let existing = plans.find(p => p.product === plan.product && p.date === plan.date);
                    if (existing) {
                        existing.bom = plan.bom;
                        existing.quantity = plan.quantity;
                    } else {
                        plans.push(plan);
                    }
                    addedPlansCount++;
                });

                saveData();
                alert(`Uspešno obrađeno i uvezeno ${addedPlansCount} proizvodnih planova!`);
                event.target.value = '';
            };
            reader.readAsText(file, 'UTF-8');
        }

        function exportMaterialsCSV() {
            let csv = "part_number;description;supplier_name;current_stock;in_transit;min_stock\n";
            materials.forEach(m => {
                csv += `${m.partNumber};${m.description};${m.supplier};${m.stock};${m.transit};${m.minStock}\n`;
            });
            downloadCSV(csv, "materijali.csv");
        }

        function exportMatrixCSV() {
            let analytics = materials.map(m => {
                let proj = calculateMaterialProjection(m, 30);
                return { ...m, dCover: proj.daysCoverCount, firstDeficit: proj.firstDeficitDate, status: proj.status };
            });
            let csv = "part_number;description;supplier;stock;in_transit;min_stock;days_cover;first_deficit;status\n";
            analytics.forEach(a => {
                csv += `${a.partNumber};${a.description};${a.supplier};${a.stock};${a.transit};${a.minStock};${a.dCover !== null ? a.dCover : ''};${a.firstDeficit};${a.status}\n`;
            });
            downloadCSV(csv, "izvestaj_pokrivenosti.csv");
        }

        function downloadCSV(csv, filename) {
            let blob = new Blob(["\uFEFF" + csv], { type: 'text/csv;charset=utf-8;' });
            let url = URL.createObjectURL(blob);
            let a = document.createElement('a');
            a.href = url;
            a.download = filename;
            a.click();
        }

        window.onload = function() {
            initApp();
        };
    </script>
