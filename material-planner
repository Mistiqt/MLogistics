        function renderMatrix() {
            let daysLimit = Number(document.getElementById('matrixDaysSelect').value);
            let analytics = materials.map(m => {
                let proj = calculateMaterialProjection(m, daysLimit);
                return {
                    ...m,
                    dCover: proj.daysCoverCount !== null ? proj.daysCoverCount : null,
                    firstDeficit: proj.firstDeficitDate,
                    status: proj.status,
                    statusClass: proj.statusClass
                };
            });

            let tbody = document.getElementById('matrixTableBody');
            tbody.innerHTML = '';
            analytics.forEach(a => {
                tbody.innerHTML += `
                    <tr class="hover:bg-gray-800/40">
                        <td class="py-3.5 px-5 font-mono text-xs text-blue-400">${a.partNumber}</td>
                        <td class="py-3.5 px-5">${a.description}</td>
                        <td class="py-3.5 px-5">${a.supplier || '—'}</td>
                        <td class="py-3.5 px-5">${a.stock}</td>
                        <td class="py-3.5 px-5 text-blue-300 font-semibold">${a.transit}</td>
                        <td class="py-3.5 px-5">${a.minStock}</td>
                        <td class="py-3.5 px-5 font-bold ${a.dCover !== null ? 'text-emerald-400' : 'text-gray-500'}">${a.dCover !== null ? a.dCover + ' dana' : '—'}</td>
